flowchart LR
    Users["Users"]
    WS(("Web Servlet"))
    LP(("Login Process"))
    CLD(("College Library Database"))
    WP[("Web Pages")]
    DF[("Datbase Files")]
    DF1[("Datbase Files1")]

    Users -- "Login Request" --> WS
    WS -- "Login Response" --> Users

    WS -- "AuthenticateUser()" --> LP
    LP -- "Authenticate User Result" --> WS

    LP -- "Authenticate User SQL Query" --> CLD
    CLD -- "Authenticate User SQL Query Result" --> LP

    WS -- "Pages" --> WP
    WP -- "Pages" --> WS

    CLD -- "Data" --> DF
    CLD -- "Data" --> DF1
    DF -- "Data" --> CLD

    subgraph Boundary1["User / Web Server Boundary"]
    end
    subgraph Boundary2["Web Server / Database Boundary"]
    end

    %% Keep presentation next to the diagram definition, not in the report generator.
    style Users fill:#fef3c7,stroke:#b45309,stroke-width:2px,color:#451a03
    style WS fill:#bfdbfe,stroke:#1d4ed8,stroke-width:2px,color:#172554
    style LP fill:#bbf7d0,stroke:#15803d,stroke-width:2px,color:#052e16
    style CLD fill:#fed7aa,stroke:#c2410c,stroke-width:2px,color:#431407
    style WP fill:#e9d5ff,stroke:#7e22ce,stroke-width:2px,color:#3b0764
    style DF fill:#fbcfe8,stroke:#be185d,stroke-width:2px,color:#500724
